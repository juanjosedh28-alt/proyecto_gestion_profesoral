@* ======================================================================= *@
@* PROGRAMAS (tabla puente docente_departamento)                           *@
@* ======================================================================= *@
<section id="programas" class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Programas en los que está vinculado</h2></div>
    <div class="card-body">
        @if (Model.Departamentos.Count == 0) { <p class="text-muted">No está vinculado a ningún programa.</p> }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Programa</th><th>Dedicación</th><th>Modalidad</th><th>Ingreso</th><th>Salida</th><th></th></tr></thead>
                <tbody>
                @foreach (var x in Model.Departamentos)
                {
                    <tr>
                        <td>@x.DepartamentoNombre</td><td>@x.Dedicacion</td><td>@x.Modalidad</td><td>@x.FechaIngreso</td><td>@(x.FechaSalida ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditarPrograma" asp-route-cedula="@d.Cedula" asp-route-departamento="@x.Departamento">Editar</a>
                            <form method="post" asp-page-handler="RetirarPrograma" asp-route-cedula="@d.Cedula" asp-route-departamento="@x.Departamento" class="d-inline" onsubmit="return confirm('¿Retirar esta vinculación?')">
                                <button class="btn btn-sm btn-outline-danger">Retirar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h3 class="h6 mt-3">Vincular a un programa</h3>
        @foreach (var e in Model.ErroresDe("programas")) { <div class="alert alert-danger py-1 mb-1">@e</div> }
        @if (Model.OpcionesProgramas.Count == 0)
        {
            <p class="text-muted">Aún no hay programas. Cree uno primero en <a href="/Programas/Crear">Programas</a>.</p>
        }
        else
        {
            var p = Model.NuevoPrograma;
            <form method="post" asp-page-handler="AsignarPrograma" asp-route-cedula="@d.Cedula" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Programa</label>
                    @* Desplegable: la persona VE el nombre del programa; se MANDA su id *@
                    <select class="form-select form-select-sm" name="programa.Departamento">
                        <option value="">— seleccione —</option>
                        @foreach (var o in Model.OpcionesProgramas)
                        {
                            <option value="@o.Id" selected="@(p.Departamento == o.Id)">@o.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Dedicación</label>
                    <select class="form-select form-select-sm" name="programa.Dedicacion">
                        @foreach (var t in new[] { "Tiempo completo", "Medio tiempo", "Cátedra" })
                        {
                            <option selected="@(p.Dedicacion == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Modalidad</label>
                    <input class="form-control form-control-sm" name="programa.Modalidad" value="@p.Modalidad" placeholder="Presencial" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Ingreso</label>
                    <input class="form-control form-control-sm" type="date" name="programa.FechaIngreso" value="@p.FechaIngreso" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Salida (opcional)</label>
                    <input class="form-control form-control-sm" type="date" name="programa.FechaSalida" value="@p.FechaSalida" />
                </div>
                <div class="col-12"><button class="btn btn-sm btn-primary">Vincular</button></div>
            </form>
        }
    </div>
</section>

@* ======================================================================= *@
@* REDES (tabla puente red_docente)                                        *@
@* ======================================================================= *@
<section id="redes" class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Redes académicas</h2></div>
    <div class="card-body">
        @if (Model.RedesDelDocente.Count == 0) { <p class="text-muted">No pertenece a ninguna red.</p> }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Red</th><th>Desde</th><th>Hasta</th><th>Actividades destacadas</th><th></th></tr></thead>
                <tbody>
                @foreach (var x in Model.RedesDelDocente)
                {
                    <tr>
                        <td>@x.RedNombre</td><td>@x.FechaInicio</td><td>@(x.FechaFin ?? "—")</td><td>@x.ActDestacadas</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditarRed" asp-route-cedula="@d.Cedula" asp-route-red="@x.Red">Editar</a>
                            <form method="post" asp-page-handler="RetirarRed" asp-route-cedula="@d.Cedula" asp-route-red="@x.Red" class="d-inline" onsubmit="return confirm('¿Retirar de esta red?')">
                                <button class="btn btn-sm btn-outline-danger">Retirar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h3 class="h6 mt-3">Agregar a una red</h3>
        @foreach (var e in Model.ErroresDe("redes")) { <div class="alert alert-danger py-1 mb-1">@e</div> }
        @if (Model.OpcionesRedes.Count == 0)
        {
            <p class="text-muted">Aún no hay redes. Cree una primero en <a href="/Redes/Crear">Redes</a>.</p>
        }
        else
        {
            var n = Model.NuevaRed;
            <form method="post" asp-page-handler="AsignarRed" asp-route-cedula="@d.Cedula" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">Red</label>
                    <select class="form-select form-select-sm" name="red.Red">
                        <option value="">— seleccione —</option>
                        @foreach (var o in Model.OpcionesRedes)
                        {
                            <option value="@o.Idr" selected="@(n.Red == o.Idr)">@o.Nombre (@o.Pais)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Desde</label>
                    <input class="form-control form-control-sm" type="date" name="red.FechaInicio" value="@n.FechaInicio" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">Hasta (opcional)</label>
                    <input class="form-control form-control-sm" type="date" name="red.FechaFin" value="@n.FechaFin" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small">Actividades destacadas</label>
                    <input class="form-control form-control-sm" name="red.ActDestacadas" value="@n.ActDestacadas" />
                </div>
                <div class="col-12"><button class="btn btn-sm btn-primary">Agregar a la red</button></div>
            </form>
        }
    </div>
</section>

@* ======================================================================= *@
@* INTERESES FUTUROS (puente PURO: se asigna o se retira, no se edita)     *@
@* ======================================================================= *@
<section id="intereses" class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Intereses de investigación</h2></div>
    <div class="card-body">
        @if (Model.Intereses.Count == 0) { <p class="text-muted">Sin intereses registrados.</p> }
        else
        {
            <ul class="list-group mb-3" style="max-width:40em">
            @foreach (var x in Model.Intereses)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@x.TerminoClave @if (x.TerminoIngles != null) { <small class="text-muted">(@x.TerminoIngles)</small> }</span>
                    <form method="post" asp-page-handler="RetirarInteres" asp-route-cedula="@d.Cedula" asp-route-termino="@x.TerminoClave" class="d-inline" onsubmit="return confirm('¿Retirar este interés?')">
                        <button class="btn btn-sm btn-outline-danger">Retirar</button>
                    </form>
                </li>
            }
            </ul>
        }

        @foreach (var e in Model.ErroresDe("intereses")) { <div class="alert alert-danger py-1 mb-1">@e</div> }
        @if (Model.OpcionesTerminos.Count == 0)
        {
            <p class="text-muted">Aún no hay términos clave. Cree uno primero en <a href="/TerminosClave/Crear">Términos clave</a>.</p>
        }
        else
        {
            <form method="post" asp-page-handler="AsignarInteres" asp-route-cedula="@d.Cedula" class="d-flex gap-2" style="max-width:40em">
                <select class="form-select form-select-sm" name="interes.TerminoClave">
                    <option value="">— seleccione un término —</option>
                    @foreach (var o in Model.OpcionesTerminos)
                    {
                        <option value="@o.Termino" selected="@(Model.NuevoInteres.TerminoClave == o.Termino)">@o.Termino</option>
                    }
                </select>
                <button class="btn btn-sm btn-primary text-nowrap">Agregar interés</button>
            </form>
        }
    </div>
</section>

@section Scripts {
<script>
    // Formularios de VARIOS RENGLONES (sin librerías).
    // "+ Otro renglón" copia el último renglón vacío; "✕" lo quita. Después se
    // vuelven a numerar los nombres (estudios[0].Titulo, estudios[1].Titulo...)
    // para que el servidor los reciba como UNA lista y los mande en UN solo envío.
    function renumerar(cuerpo) {
        cuerpo.querySelectorAll('.renglon').forEach(function (fila, i) {
            fila.querySelectorAll('[name]').forEach(function (campo) {
                campo.name = campo.name.replace(/\[\d+\]/, '[' + i + ']');
            });
        });
    }
    document.querySelectorAll('[data-agregar]').forEach(function (boton) {
        boton.addEventListener('click', function () {
            var cuerpo = boton.closest('form').querySelector('[data-renglones]');
            var filas = cuerpo.querySelectorAll('.renglon');
            var copia = filas[filas.length - 1].cloneNode(true);
            copia.querySelectorAll('input').forEach(function (c) { c.value = ''; });
            cuerpo.appendChild(copia);
            renumerar(cuerpo);
        });
    });
    document.addEventListener('click', function (e) {
        if (!e.target.matches('[data-quitar]')) return;
        var cuerpo = e.target.closest('[data-renglones]');
        if (cuerpo.querySelectorAll('.renglon').length === 1) return;   // siempre queda al menos uno
        e.target.closest('.renglon').remove();
        renumerar(cuerpo);
    });
</script>
}
