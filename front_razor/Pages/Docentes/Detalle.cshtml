@page "{cedula:int}"
@model front_razor.Pages.Docentes.DetalleModel
@{
    ViewData["Title"] = Model.Docente.NombreCompleto;
    var d = Model.Docente;
}
@*
    MAESTRO-DETALLE: arriba el docente (maestro); debajo, sus siete secciones (detalle).
    Ninguna clave foránea se escribe a mano: el docente viene de la ruta y los demás
    (programa, red, término) se eligen de desplegables cargados desde la API.
*@

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@d.NombreCompleto</h1>
        <div class="text-muted">Cédula @d.Cedula · @d.Cargo · @d.Escalafon</div>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-outline-primary" asp-page="Editar" asp-route-cedula="@d.Cedula">Editar docente</a>
        <a class="btn btn-secondary" asp-page="Index">Volver</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row small">
            <div class="col-md-4"><strong>Correo:</strong> @d.Correo</div>
            <div class="col-md-4"><strong>Teléfono:</strong> @d.Telefono</div>
            <div class="col-md-4"><strong>Nacimiento:</strong> @d.FechaNacimiento</div>
            <div class="col-md-4"><strong>Nacionalidad:</strong> @d.Nacionalidaad</div>
            <div class="col-md-4"><strong>Línea principal:</strong> @(d.LineaInvestigacionPrincipalNombre ?? "(ninguna)")</div>
            <div class="col-md-4"><strong>CvLAC:</strong> <a href="@d.UrlCvlac" target="_blank" rel="noopener">abrir</a></div>
            <div class="col-md-4"><strong>Categoría Minciencias:</strong> @(d.CatMinciencia ?? "—")</div>
            <div class="col-md-4"><strong>Convocatoria:</strong> @d.ConvMinciencia</div>
            <div class="col-md-4"><strong>Última actualización:</strong> @d.FechaActualizacion</div>
            <div class="col-12 mt-2"><strong>Perfil:</strong> @d.Perfil</div>
        </div>
        @* Este número NO lo envía el front ni la API: lo mantiene el disparador trg_contar_estudios. *@
        <div class="mt-3"><span class="badge text-bg-primary fs-6">Estudios activos: @d.TotalEstudios</span></div>
    </div>
</div>

@* ======================================================================= *@
@* ESTUDIOS REALIZADOS                                                     *@
@* ======================================================================= *@
<section id="estudios" class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Estudios realizados</h2></div>
    <div class="card-body">
        @if (Model.Estudios.Count == 0) { <p class="text-muted">Sin estudios registrados.</p> }
        else
        {
            <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Id</th><th>Título</th><th>Tipo</th><th>Universidad</th><th>Fecha</th><th>País</th><th></th></tr></thead>
                <tbody>
                @foreach (var x in Model.Estudios)
                {
                    <tr>
                        <td>@x.Id</td><td>@x.Titulo</td><td>@x.Tipo</td><td>@x.Universidad</td><td>@x.Fecha</td><td>@x.Pais</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/EstudiosRealizados/Detalle" asp-route-id="@x.Id">Apoyo, beca y áreas</a>
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditarEstudio" asp-route-cedula="@d.Cedula" asp-route-id="@x.Id">Editar</a>
                            <form method="post" asp-page-handler="RetirarEstudio" asp-route-cedula="@d.Cedula" asp-route-id="@x.Id" class="d-inline" onsubmit="return confirm('¿Retirar este estudio?')">
                                <button class="btn btn-sm btn-outline-danger">Retirar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }

        <h3 class="h6 mt-3">Agregar estudios</h3>
        @foreach (var e in Model.ErroresDe("estudios")) { <div class="alert alert-danger py-1 mb-1">@e</div> }
        <form method="post" asp-page-handler="AgregarEstudios" asp-route-cedula="@d.Cedula">
            <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Id</th><th>Título</th><th>Tipo</th><th>Universidad</th><th>Fecha</th><th>Ciudad</th><th>País</th><th>Metodología</th><th>Acreditada</th><th>Perfil del egresado</th><th></th></tr></thead>
                <tbody data-renglones>
                @{ var filasEst = Model.NuevosEstudios.Count > 0 ? Model.NuevosEstudios : new List<EstudioFormulario> { new() }; }
                @for (var i = 0; i < filasEst.Count; i++)
                {
                    var r = filasEst[i];
                    <tr class="renglon">
                        <td><input class="form-control form-control-sm" type="number" name="estudios[@i].Id" value="@r.Id" style="width:6em" /></td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].Titulo" value="@r.Titulo" /></td>
                        <td>
                            <select class="form-select form-select-sm" name="estudios[@i].Tipo">
                                @foreach (var t in new[] { "Pregrado", "Especialización", "Maestría", "Doctorado", "Posdoctorado" })
                                {
                                    <option selected="@(r.Tipo == t)">@t</option>
                                }
                            </select>
                        </td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].Universidad" value="@r.Universidad" /></td>
                        <td><input class="form-control form-control-sm" type="date" name="estudios[@i].Fecha" value="@r.Fecha" /></td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].Ciudad" value="@r.Ciudad" /></td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].Pais" value="@r.Pais" /></td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].Metodologia" value="@r.Metodologia" placeholder="Presencial" /></td>
                        <td>
                            <select class="form-select form-select-sm" name="estudios[@i].InsAcreditada">
                                <option value="1" selected="@(r.InsAcreditada == 1)">Sí</option>
                                <option value="0" selected="@(r.InsAcreditada == 0)">No</option>
                            </select>
                        </td>
                        <td><input class="form-control form-control-sm" name="estudios[@i].PerfilEgresado" value="@r.PerfilEgresado" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-secondary" data-quitar title="Quitar renglón">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-agregar>+ Otro renglón</button>
            <button class="btn btn-sm btn-primary">Guardar estudios</button>
        </form>
    </div>
</section>

@* ======================================================================= *@
@* EVALUACIONES                                                            *@
@* ======================================================================= *@
<section id="evaluaciones" class="card mb-4">
    <div class="card-header"><h2 class="h5 mb-0">Evaluaciones docentes</h2></div>
    <div class="card-body">
        @if (Model.Evaluaciones.Count == 0) { <p class="text-muted">Sin evaluaciones registradas.</p> }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Semestre</th><th>Calificación</th><th></th></tr></thead>
                <tbody>
                @foreach (var x in Model.Evaluaciones)
                {
                    <tr>
                        <td>@x.Semestre</td><td>@x.Calificacion.ToString("0.0#")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditarEvaluacion" asp-route-cedula="@d.Cedula" asp-route-id="@x.Id">Editar</a>
                            <form method="post" asp-page-handler="RetirarEvaluacion" asp-route-cedula="@d.Cedula" asp-route-id="@x.Id" class="d-inline" onsubmit="return confirm('¿Retirar esta evaluación?')">
                                <button class="btn btn-sm btn-outline-danger">Retirar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }

        <h3 class="h6 mt-3">Agregar evaluaciones</h3>
        @foreach (var e in Model.ErroresDe("evaluaciones")) { <div class="alert alert-danger py-1 mb-1">@e</div> }
        <form method="post" asp-page-handler="AgregarEvaluaciones" asp-route-cedula="@d.Cedula">
            <table class="table table-sm" style="max-width:40em">
                <thead><tr><th>Semestre</th><th>Calificación (0 a 5)</th><th></th></tr></thead>
                <tbody data-renglones>
                @{ var filasEva = Model.NuevasEvaluaciones.Count > 0 ? Model.NuevasEvaluaciones : new List<EvaluacionFormulario> { new() }; }
                @for (var i = 0; i < filasEva.Count; i++)
                {
                    var r = filasEva[i];
                    <tr class="renglon">
                        <td><input class="form-control form-control-sm" name="evaluaciones[@i].Semestre" value="@r.Semestre" placeholder="2026-1" /></td>
                        <td><input class="form-control form-control-sm" type="number" step="0.1" min="0" max="5" name="evaluaciones[@i].Calificacion" value="@(r.Calificacion?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></td>
                        <td><button type="button" class="btn btn-sm btn-outline-secondary" data-quitar title="Quitar renglón">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-agregar>+ Otro renglón</button>
            <button class="btn btn-sm btn-primary">Guardar evaluaciones</button>
        </form>
    </div>
</section>

