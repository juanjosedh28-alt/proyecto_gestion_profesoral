<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión Profesoral</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Gestión Profesoral</a>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/AreasConocimiento">Áreas de conocimiento</a></li>
                <li class="nav-item"><a class="nav-link" href="/TerminosClave">Términos clave</a></li>
                <li class="nav-item"><a class="nav-link" href="/LineasInvestigacion">Líneas de investigación</a></li>
                <li class="nav-item"><a class="nav-link" href="/Programas">Programas</a></li>
                <li class="nav-item"><a class="nav-link" href="/Redes">Redes</a></li>
            </ul>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Exito"] is string exito) { <div class="alert alert-success">@exito</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
