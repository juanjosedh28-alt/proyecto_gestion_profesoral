@page
@model front_razor.Pages.ApoyosProfesorales.IndexModel
@{ ViewData["Title"] = "Apoyos Profesorales"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Apoyos Profesorales</h1>
    <a class="btn btn-primary" href="/ApoyosProfesorales/Crear">Nuevo apoyo</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Estudio</th><th>Con Apoyo</th><th>Institución</th><th>Tipo</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.EstudioTitulo (@item.Estudios)</td>
                <td>@(item.ConApoyo == 1 ? "Sí" : "No")</td>
                <td>@item.Institucion</td>
                <td>@item.Tipo</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/ApoyosProfesorales/Editar?estudios=@item.Estudios">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-estudios="@item.Estudios" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
