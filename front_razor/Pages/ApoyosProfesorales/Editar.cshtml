@page
@model front_razor.Pages.ApoyosProfesorales.EditarModel
@{ ViewData["Title"] = "Editar Apoyo Profesoral"; }

<h1 class="h4 mb-3">Editar Apoyo del Estudio #@Model.Estudios</h1>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Estudios" />
    <input type="hidden" asp-for="Formulario.Estudios" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3"><label class="form-label">ID Estudio</label><input value="@Model.Estudios" class="form-control" disabled /></div>
    <div class="mb-3">
        <label class="form-label">¿Con Apoyo?</label>
        <select asp-for="Formulario.ConApoyo" class="form-select"><option value="1">Sí (1)</option><option value="0">No (0)</option></select>
    </div>
    <div class="mb-3"><label class="form-label">Institución</label><input asp-for="Formulario.Institucion" class="form-control" /><span asp-validation-for="Formulario.Institucion" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Tipo</label><input asp-for="Formulario.Tipo" class="form-control" /><span asp-validation-for="Formulario.Tipo" class="text-danger"></span></div>
    <button class="btn btn-primary">Actualizar</button>
    <a class="btn btn-secondary" href="/ApoyosProfesorales">Cancelar</a>
</form>
