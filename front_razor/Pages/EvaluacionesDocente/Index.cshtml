@page
@model front_razor.Pages.EvaluacionesDocente.IndexModel
@{ ViewData["Title"] = "Evaluaciones Docente"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Evaluaciones Docente</h1>
    <a class="btn btn-primary" href="/EvaluacionesDocente/Crear">Nueva evaluación</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Docente (Cédula)</th>
            <th>Semestre</th>
            <th>Calificación</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.DocenteNombre (@item.Docente)</td>
                <td>@item.Semestre</td>
                <td>@item.Calificacion</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/EvaluacionesDocente/Editar?id=@item.Id">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('¿Eliminar esta evaluación?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
