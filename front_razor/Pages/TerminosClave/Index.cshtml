@page
@model front_razor.Pages.TerminosClave.IndexModel
@{ ViewData["Title"] = "Términos clave"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Términos clave</h1>
    <a class="btn btn-primary" asp-page="Crear">Nuevo</a>
</div>

@if (Model.MensajeError != null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}
else if (Model.Items.Count == 0)
{
    <p class="text-muted">No hay registros.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Término</th><th>Término en inglés</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.Termino</td><td>@x.TerminoIngles</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-termino="@x.Termino">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-termino="@x.Termino" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este registro?')">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
