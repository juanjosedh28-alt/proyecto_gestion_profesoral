@page "{id:int}"
@model front_razor.Pages.LineasInvestigacion.EditarModel
@{
    ViewData["Title"] = "Editar registro";
    ViewData["Editando"] = true;
}

<h1 class="h3 mb-3">Editar registro — Líneas de investigación</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <partial name="_Campos" model="Model.Formulario" view-data="ViewData" />
    <button class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-secondary" asp-page="Index">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
