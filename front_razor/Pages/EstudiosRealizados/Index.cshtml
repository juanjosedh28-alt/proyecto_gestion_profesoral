@page
@model front_razor.Pages.EstudiosRealizados.IndexModel
@{ ViewData["Title"] = "Estudios Realizados"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Estudios Realizados</h1>
    <a class="btn btn-primary" href="/EstudiosRealizados/Crear">Nuevo estudio</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>ID</th><th>Docente</th><th>Título</th><th>Universidad</th><th>Tipo</th><th>Fecha</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.DocenteNombre (@item.Docente)</td>
                <td>@item.Titulo</td>
                <td>@item.Universidad</td>
                <td>@item.Tipo</td>
                <td>@item.Fecha</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/EstudiosRealizados/Editar?id=@item.Id">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('¿Eliminar este estudio?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
