@page
@model front_razor.Pages.EstudiosRealizados.EditarModel
@{ ViewData["Title"] = "Editar Estudio"; }

<h1 class="h4 mb-3">Editar Estudio #@Model.Id</h1>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Formulario.Id" />
    <input type="hidden" asp-for="Formulario.Docente" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3"><label class="form-label">Docente</label><input value="@Model.Formulario.Docente" class="form-control" disabled /></div>
    <div class="mb-3"><label class="form-label">Título</label><input asp-for="Formulario.Titulo" class="form-control" /><span asp-validation-for="Formulario.Titulo" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Universidad</label><input asp-for="Formulario.Universidad" class="form-control" /><span asp-validation-for="Formulario.Universidad" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Fecha</label><input asp-for="Formulario.Fecha" type="date" class="form-control" /><span asp-validation-for="Formulario.Fecha" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Tipo</label><input asp-for="Formulario.Tipo" class="form-control" /><span asp-validation-for="Formulario.Tipo" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Ciudad</label><input asp-for="Formulario.Ciudad" class="form-control" /><span asp-validation-for="Formulario.Ciudad" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">País</label><input asp-for="Formulario.Pais" class="form-control" /><span asp-validation-for="Formulario.Pais" class="text-danger"></span></div>
    <div class="mb-3">
        <label class="form-label">Institución Acreditada</label>
        <select asp-for="Formulario.InsAcreditada" class="form-select"><option value="1">Sí</option><option value="0">No</option></select>
    </div>
    <div class="mb-3"><label class="form-label">Metodología</label><input asp-for="Formulario.Metodologia" class="form-control" /><span asp-validation-for="Formulario.Metodologia" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Perfil del Egresado</label><textarea asp-for="Formulario.PerfilEgresado" class="form-control" rows="3"></textarea><span asp-validation-for="Formulario.PerfilEgresado" class="text-danger"></span></div>
    <button class="btn btn-primary">Actualizar</button>
    <a class="btn btn-secondary" href="/EstudiosRealizados">Cancelar</a>
</form>
