@page
@model front_razor.Pages.InteresesFuturos.IndexModel
@{ ViewData["Title"] = "Intereses Futuros"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Intereses Futuros (Docente — Término Clave)</h1>
    <a class="btn btn-primary" href="/InteresesFuturos/Crear">Nuevo interés</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Docente</th><th>Término Clave</th><th>Traducción Inglés</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.DocenteNombre (@item.Docente)</td>
                <td>@item.TerminoClave</td>
                <td>@(item.TerminoIngles ?? "-")</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Eliminar" asp-route-docente="@item.Docente" asp-route-termino="@item.TerminoClave" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
