@page
@model front_razor.Pages.Usuarios.IndexModel
@{ ViewData["Title"] = "Usuarios"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Usuarios</h1>
    <a class="btn btn-primary" asp-page="Crear">Nuevo usuario</a>
</div>

@if (Model.MensajeError != null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Usuario</th><th>Nombre</th><th>Correo</th><th>Roles</th><th>Actualizado</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>
                <td>@x.Username</td>
                <td>@x.NombreCompleto</td>
                <td>@x.Email</td>
                <td>@x.Roles</td>
                <td>@x.FechaActualizacion</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-id="@x.Id">Editar</a>
                    <form method="post" asp-page-handler="Retirar" asp-route-id="@x.Id" class="d-inline"
                          onsubmit="return confirm('¿Retirar este usuario? Ya no podrá iniciar sesión.')">
                        <button class="btn btn-sm btn-outline-danger">Retirar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <p class="small text-muted">La contraseña no aparece en ningún listado: solo se guarda su huella, que no se puede convertir de vuelta en la contraseña.</p>
}
