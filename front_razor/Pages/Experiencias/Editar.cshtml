@page
@model front_razor.Pages.Experiencias.EditarModel
@{ ViewData["Title"] = "Editar Experiencia"; }

<h1 class="h4 mb-3">Editar Experiencia #@Model.Id</h1>
<form method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Formulario.Docente" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3"><label class="form-label">Docente</label><input value="@Model.Formulario.Docente" class="form-control" disabled /></div>
    <div class="mb-3"><label class="form-label">Cargo</label><input asp-for="Formulario.NombreCargo" class="form-control" /><span asp-validation-for="Formulario.NombreCargo" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Institución</label><input asp-for="Formulario.Institucion" class="form-control" /><span asp-validation-for="Formulario.Institucion" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Tipo</label><input asp-for="Formulario.Tipo" class="form-control" /><span asp-validation-for="Formulario.Tipo" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Fecha Inicio</label><input asp-for="Formulario.FechaInicio" type="date" class="form-control" /><span asp-validation-for="Formulario.FechaInicio" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Fecha Fin</label><input asp-for="Formulario.FechaFin" type="date" class="form-control" /></div>
    <button class="btn btn-primary">Actualizar</button>
    <a class="btn btn-secondary" href="/Experiencias">Cancelar</a>
</form>
