@page
@model front_razor.Pages.Reconocimientos.CrearModel
@{ ViewData["Title"] = "Nuevo Reconocimiento"; }

<h1 class="h4 mb-3">Registrar Reconocimiento</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label class="form-label">Docente</label>
        <select asp-for="Formulario.Docente" class="form-select">
            <option value="">-- Seleccione un docente --</option>
            @foreach (var d in Model.Docentes) { <option value="@d.Cedula">@d.NombreCompleto (@d.Cedula)</option> }
        </select>
        <span asp-validation-for="Formulario.Docente" class="text-danger"></span>
    </div>
    <div class="mb-3"><label class="form-label">Nombre</label><input asp-for="Formulario.Nombre" class="form-control" /><span asp-validation-for="Formulario.Nombre" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Tipo</label><input asp-for="Formulario.Tipo" class="form-control" /><span asp-validation-for="Formulario.Tipo" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Institución</label><input asp-for="Formulario.Institucion" class="form-control" /><span asp-validation-for="Formulario.Institucion" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Ámbito</label><input asp-for="Formulario.Ambito" class="form-control" /><span asp-validation-for="Formulario.Ambito" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Fecha</label><input asp-for="Formulario.Fecha" type="date" class="form-control" /><span asp-validation-for="Formulario.Fecha" class="text-danger"></span></div>
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" href="/Reconocimientos">Cancelar</a>
</form>
