@page
@model front_razor.Pages.RedesDocentes.IndexModel
@{ ViewData["Title"] = "Red - Docente"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Red — Docente</h1>
    <a class="btn btn-primary" href="/RedesDocentes/Crear">Nueva vinculación</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Red</th><th>Docente</th><th>Inicio</th><th>Fin</th><th>Actividades Destacadas</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.RedNombre (@item.Red)</td>
                <td>@item.DocenteNombre (@item.Docente)</td>
                <td>@item.FechaInicio</td>
                <td>@(item.FechaFin ?? "-")</td>
                <td>@item.ActDestacadas</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/RedesDocentes/Editar?red=@item.Red&docente=@item.Docente">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-red="@item.Red" asp-route-docente="@item.Docente" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
