@page
@using front_razor.Infraestructura
@{
    ViewData["Title"] = "Inicio";
    // (v3) Solo aparece lo que esta persona puede abrir (las mismas rutas que el menú).
    // Las tablas de detalle y las relaciones cuelgan del docente: se ven con «interfaz.docentes».
    bool Puede(string ruta) => SesionUsuario.Tiene(HttpContext.Session, ruta);
    var escribe = Puede("datos.modificar");
}

@* La portada: el nombre del módulo en grande y, debajo, quién entró y qué puede hacer. *@
<section class="gp-portada">
    <h1 class="gp-titular"><span>Gestión</span><span>Profesoral</span></h1>
    <p class="gp-saludo">
        Hola, @SesionUsuario.Nombre(HttpContext.Session). Entró como <strong>@SesionUsuario.Roles(HttpContext.Session)</strong>, así que
        @(escribe ? "puede consultar, crear, editar y retirar registros." : "puede consultar todo, sin cambiar nada.")
    </p>
</section>

@* Las 16 tablas del módulo, en el orden y con la numeración de la especificación. *@
@if (Puede("interfaz.areas") || Puede("interfaz.terminos") || Puede("interfaz.lineas") || Puede("interfaz.programas") || Puede("interfaz.redes"))
{
<section class="gp-indice gp-catalogos">
    <header><h2>Catálogos</h2><p>Las listas base del módulo. No dependen de otra tabla.</p></header>
    <ol class="gp-lista">
        @if (Puede("interfaz.areas")) { <li><a href="/AreasConocimiento"><span class="gp-num">1</span><span class="gp-nombre">Áreas de conocimiento</span></a></li> }
        @if (Puede("interfaz.terminos")) { <li><a href="/TerminosClave"><span class="gp-num">2</span><span class="gp-nombre">Términos clave</span></a></li> }
        @if (Puede("interfaz.lineas")) { <li><a href="/LineasInvestigacion"><span class="gp-num">3</span><span class="gp-nombre">Líneas de investigación</span></a></li> }
        @if (Puede("interfaz.programas")) { <li><a href="/Programas"><span class="gp-num">4</span><span class="gp-nombre">Programas</span></a></li> }
        @if (Puede("interfaz.redes")) { <li><a href="/Redes"><span class="gp-num">5</span><span class="gp-nombre">Redes</span></a></li> }
    </ol>
</section>
}

@if (Puede("interfaz.docentes"))
{
<section class="gp-indice gp-docentes">
    <header><h2>Docentes</h2><p>El maestro del módulo y todo lo que pertenece a cada docente.</p></header>
    <ol class="gp-lista">
        <li class="gp-maestro"><a href="/Docentes"><span class="gp-num">6</span><span class="gp-nombre">Docentes</span><span class="gp-nota">En su detalle está toda su información</span></a></li>
        <li><a href="/EstudiosRealizados"><span class="gp-num">7</span><span class="gp-nombre">Estudios realizados</span><span class="gp-nota">De un docente</span></a></li>
        <li><a href="/EvaluacionesDocente"><span class="gp-num">8</span><span class="gp-nombre">Evaluaciones docente</span><span class="gp-nota">De un docente</span></a></li>
        <li><a href="/Reconocimientos"><span class="gp-num">9</span><span class="gp-nombre">Reconocimientos</span><span class="gp-nota">De un docente</span></a></li>
        <li><a href="/Experiencias"><span class="gp-num">10</span><span class="gp-nombre">Experiencias</span><span class="gp-nota">De un docente</span></a></li>
        <li><a href="/ApoyosProfesorales"><span class="gp-num">11</span><span class="gp-nombre">Apoyo profesoral</span><span class="gp-nota">Uno por estudio</span></a></li>
        <li><a href="/Becas"><span class="gp-num">12</span><span class="gp-nombre">Becas</span><span class="gp-nota">Una por estudio</span></a></li>
    </ol>
</section>

<section class="gp-indice gp-relaciones">
    <header><h2>Relaciones</h2><p>Cada una une dos tablas.</p></header>
    <ol class="gp-lista">
        <li><a href="/DocentesDepartamentos"><span class="gp-num">13</span><span class="gp-nombre">Docente y departamento</span><span class="gp-nota">Docente con programa</span></a></li>
        <li><a href="/InteresesFuturos"><span class="gp-num">14</span><span class="gp-nombre">Intereses futuros</span><span class="gp-nota">Docente con término clave</span></a></li>
        <li><a href="/RedesDocentes"><span class="gp-num">15</span><span class="gp-nombre">Red y docente</span><span class="gp-nota">Red con docente</span></a></li>
        <li><a href="/EstudiosAc"><span class="gp-num">16</span><span class="gp-nombre">Estudio y área de conocimiento</span><span class="gp-nota">Estudio con área</span></a></li>
    </ol>
</section>
}

@if (Puede("interfaz.usuarios") || Puede("interfaz.roles") || Puede("interfaz.permisos"))
{
<section class="gp-indice gp-acceso">
    <header><h2>Control de acceso</h2><p>Quién entra y qué puede hacer cada rol.</p></header>
    <ul class="gp-lista">
        @if (Puede("interfaz.usuarios")) { <li><a href="/Usuarios"><span class="gp-nombre">Usuarios</span><span class="gp-nota">Cuentas y sus roles</span></a></li> }
        @if (Puede("interfaz.roles")) { <li><a href="/Roles"><span class="gp-nombre">Roles</span><span class="gp-nota">Crear, editar y retirar</span></a></li> }
        @if (Puede("interfaz.permisos")) { <li><a href="/Permisos"><span class="gp-nombre">Permisos por rol</span><span class="gp-nota">Qué abre cada rol y quién modifica datos</span></a></li> }
    </ul>
</section>
}
