@page
@model front_razor.Pages.EstudiosAc.CrearModel
@{ ViewData["Title"] = "Asociar Área a Estudio"; }

<h1 class="h4 mb-3">Asociar Área de Conocimiento a Estudio</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label class="form-label">Estudio Realizado</label>
        <select asp-for="Formulario.Estudio" class="form-select">
            <option value="">-- Seleccione un estudio --</option>
            @foreach (var e in Model.Estudios) { <option value="@e.Id">@e.Titulo - @e.DocenteNombre (@e.Id)</option> }
        </select>
        <span asp-validation-for="Formulario.Estudio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Área de Conocimiento</label>
        <select asp-for="Formulario.AreaConocimiento" class="form-select">
            <option value="">-- Seleccione un área --</option>
            @foreach (var a in Model.Areas) { <option value="@a.Id">@a.Id - @a.Disciplina (@a.Area)</option> }
        </select>
        <span asp-validation-for="Formulario.AreaConocimiento" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-secondary" href="/EstudiosAc">Cancelar</a>
</form>
