@page
@model front_razor.Pages.EstudiosAc.IndexModel
@{ ViewData["Title"] = "Estudio - Área de Conocimiento"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Estudio — Área de Conocimiento</h1>
    <a class="btn btn-primary" href="/EstudiosAc/Crear">Nueva asociación</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Estudio</th><th>Código Área</th><th>Disciplina</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.EstudioTitulo (@item.Estudio)</td>
                <td>@item.AreaConocimiento</td>
                <td>@item.AreaConocimientoDisciplina</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Eliminar" asp-route-estudio="@item.Estudio" asp-route-area="@item.AreaConocimiento" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
