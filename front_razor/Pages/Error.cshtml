@page "/Error/{codigo:int?}"
@model front_razor.Pages.ErrorModel
@{ ViewData["Title"] = Model.Titulo; }

@* El código HTTP (403, 404, 500) va en la respuesta, no en la pantalla: la persona lee palabras, no números. *@
<div class="gp-aviso">
    <div class="gp-icono" aria-hidden="true">
        @if (Model.Codigo == 403)
        {
            <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm-3 8V6a3 3 0 1 1 6 0v3H9Zm3 4a2 2 0 0 1 1 3.7V19h-2v-2.3A2 2 0 0 1 12 13Z"/></svg>
        }
        else
        {
            <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z"/></svg>
        }
    </div>
    <h1 class="h3">@Model.Titulo</h1>
    <p class="text-muted">@Model.Texto</p>
    @if (Model.Codigo == 403)
    {
        @* (v3) Criterio 9: la pantalla pidió los datos, la API respondió 403 y aquí no se muestra ninguno. *@
        <p class="small text-muted">@Model.Explicacion403</p>
    }
    <a class="btn btn-primary" href="/">Ir al inicio</a>
</div>
