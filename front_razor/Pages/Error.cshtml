@page "/Error/{codigo:int?}"
@model front_razor.Pages.ErrorModel
@{ ViewData["Title"] = Model.Titulo; }

<div class="text-center py-5">
    <div class="display-4 text-muted mb-2">@Model.Codigo</div>
    <h1 class="h3">@Model.Titulo</h1>
    <p class="text-muted">@Model.Texto</p>
    <a class="btn btn-primary" href="/">Ir al inicio</a>
</div>
