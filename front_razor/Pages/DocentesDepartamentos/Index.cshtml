@page
@model front_razor.Pages.DocentesDepartamentos.IndexModel
@{ ViewData["Title"] = "Docente - Departamento"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Docente — Departamento (Programa)</h1>
    <a class="btn btn-primary" href="/DocentesDepartamentos/Crear">Nueva asignación</a>
</div>

@if (TempData["Mensaje"] is string msg) { <div class="alert alert-success">@msg</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>Docente</th><th>Programa</th><th>Dedicación</th><th>Modalidad</th><th>Ingreso</th><th>Salida</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Lista)
        {
            <tr>
                <td>@item.DocenteNombre (@item.Docente)</td>
                <td>@item.DepartamentoNombre (@item.Departamento)</td>
                <td>@item.Dedicacion</td>
                <td>@item.Modalidad</td>
                <td>@item.FechaIngreso</td>
                <td>@(item.FechaSalida ?? "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/DocentesDepartamentos/Editar?docente=@item.Docente&departamento=@item.Departamento">Editar</a>
                    <form method="post" asp-page-handler="Eliminar" asp-route-docente="@item.Docente" asp-route-departamento="@item.Departamento" class="d-inline" onsubmit="return confirm('¿Eliminar?');">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
