@model front_razor.Modelos.AreaConocimientoFormulario

<div class="mb-3">
    <label asp-for="Id" class="form-label"></label>
    @* Al editar, el código no se cambia: es la clave del registro. *@
    <input asp-for="Id" class="form-control" placeholder="Por ejemplo 1A01" readonly="@(ViewData["Editando"] is true ? "readonly" : null)" />
    <span asp-validation-for="Id" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="GranArea" class="form-label"></label>
    <input asp-for="GranArea" class="form-control" />
    <span asp-validation-for="GranArea" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Area" class="form-label"></label>
    <input asp-for="Area" class="form-control" />
    <span asp-validation-for="Area" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Disciplina" class="form-label"></label>
    <input asp-for="Disciplina" class="form-control" />
    <span asp-validation-for="Disciplina" class="text-danger"></span>
</div>
