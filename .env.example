# Copie este archivo como ".env" (en la misma carpeta) y cambie el valor.
# El .env real NO se sube a GitHub: está en .gitignore.
#
# Contraseña del usuario "sa" de SQL Server. Debe tener al menos 8 caracteres
# con mayúsculas, minúsculas, números y un símbolo, o SQL Server no arranca.
MSSQL_SA_PASSWORD=CambieEstaClave123!
